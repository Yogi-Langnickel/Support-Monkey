# Copy to .env on the work machine. Do not commit real values.

SUPPORT_MONKEY_MODE=local

# ServiceNow read-only integration, once approved on the work machine.
SERVICENOW_INSTANCE_URL=
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=
SERVICENOW_QUEUE_NAME="Digital Application Support"

# Confluence read-only integration, once approved on the work machine.
CONFLUENCE_BASE_URL=
CONFLUENCE_USERNAME=
CONFLUENCE_API_TOKEN=

# AWS access is expected to use the local AWS CLI/profile already configured on
# the work machine. Support-Monkey should call `aws` with explicit profiles and
# never store AWS secrets.
AWS_PROFILE=
AWS_REGION=

